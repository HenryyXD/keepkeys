# Copy the names you need; keepkeys reads the comments above each variable.
# Values in this file are placeholders and are never used.

# Port for the dev server (not a secret, but fine to list)
PORT=3000

# Stripe secret key for the API server
# where: https://dashboard.stripe.com/apikeys
# to: .env.local, server/.dev.vars
STRIPE_SECRET_KEY=

# Stripe webhook signing secret
# where: https://dashboard.stripe.com/webhooks
# to: server/.dev.vars
STRIPE_WEBHOOK_SECRET=

# LLM calls from the backend
OPENROUTER_API_KEY=

# optional
# Product analytics
POSTHOG_KEY=
